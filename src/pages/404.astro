---
import BaseLayout from '../layouts/BaseLayout.astro';

const DESCRIPTION = 'That page is not here. Try the writing index or the front page.';
---

<BaseLayout title="Not found" description={DESCRIPTION} noindex>
  <div class="container page">
    <p class="label code">404</p>
    <h1>This page has no boundary.</h1>
    <p class="line">Nothing is here to glue to anything else, which is usually a mistyped URL.</p>
    <p class="jump">
      <a href="/">→ front page</a>
      <a href="/posts/">→ writing</a>
    </p>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding-block: var(--space-24);
    text-align: center;
  }

  .code {
    color: var(--color-accent-2);
  }

  h1 {
    max-width: 20ch;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-3xl);
    letter-spacing: -0.015em;
  }

  .line {
    max-width: var(--measure);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .jump {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .jump a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }

  .jump a:hover {
    color: var(--color-accent-2);
  }
</style>
