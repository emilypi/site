---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPublishedNotes, type Note } from '../../lib/content';

const INTRO =
  'The short-form stream: fragments, single ideas, things that do not need an argument.';
const DESCRIPTION =
  'Short notes by Emily Pillmore — fragments and single ideas that do not need an essay around them.';

/** Below this many notes the stream reads better ungrouped, as one run of dates. */
const GROUPING_THRESHOLD = 12;

interface YearGroup {
  year: number;
  entries: Note[];
}

/**
 * Bucket notes by publication year, newest year first, each bucket keeping the
 * date-descending order it arrived in. Years are read in UTC to match
 * `formatDate`.
 */
function groupByYear(entries: Note[]): YearGroup[] {
  const years = new Map<number, Note[]>();

  for (const entry of entries) {
    const year = entry.data.date.getUTCFullYear();
    const bucket = years.get(year);
    if (bucket) bucket.push(entry);
    else years.set(year, [entry]);
  }

  return [...years.entries()]
    .map(([year, group]) => ({ year, entries: group }))
    .sort((a, b) => b.year - a.year);
}

const notes = await getPublishedNotes();
const groups = notes.length > GROUPING_THRESHOLD ? groupByYear(notes) : [];
---

<BaseLayout title="Notes" description={DESCRIPTION}>
  <div class="container page">
    <header class="page-header">
      <p class="label kind">§ notes</p>
      <h1>Notes</h1>
      <p class="intro">{INTRO}</p>
      <p class="label"><a class="link-plain" href="/tags/">browse by tag →</a></p>
    </header>

    {
      notes.length === 0 && (
        <div class="prose">
          <p>Nothing here yet.</p>
        </div>
      )
    }

    {notes.length > 0 && groups.length === 0 && <PostList entries={notes} collection="notes" />}

    {
      groups.map((group) => (
        <section class="year">
          <h2 class="label year-label">{group.year}</h2>
          <PostList entries={group.entries} collection="notes" />
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12) var(--space-24);
  }

  .page-header {
    max-width: var(--measure);
    margin-bottom: var(--space-12);
  }

  .kind {
    color: var(--color-accent-2);
  }

  h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    letter-spacing: -0.015em;
  }

  .intro {
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .year + .year {
    margin-top: var(--space-12);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-rule);
  }

  .year-label {
    margin-bottom: var(--space-6);
    color: var(--color-text-faint);
  }
</style>
