---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { SITE } from '../../site.config';

const entry = await getEntry('about', 'about');
if (!entry) throw new Error('src/content/pages/about.md is missing');

const { Content } = await render(entry);

// The feed already has its own link in the masthead and the footer; this list is
// for places on the web that are Emily rather than the site.
const elsewhere = SITE.links.filter((link) => link.icon !== 'rss');
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="container container--narrow page">
    <header class="page-header">
      <p class="label kind">§ about</p>
      <h1>{entry.data.title}</h1>
    </header>

    <article class="prose">
      <Content />
    </article>

    <section class="elsewhere">
      <SectionHeading label="§ elsewhere" />
      <ul class="links">
        {
          elsewhere.map((link) => (
            <li>
              <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-12) var(--space-24);
  }

  .page-header {
    margin-bottom: var(--space-12);
  }

  .kind {
    color: var(--color-accent-2);
  }

  h1 {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    letter-spacing: -0.015em;
  }

  .elsewhere {
    margin-top: var(--space-16);
    padding-top: var(--space-12);
    border-top: 1px solid var(--color-rule);
  }

  .links {
    display: grid;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .links a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }

  .links a:hover {
    color: var(--color-accent);
  }
</style>
