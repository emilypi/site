---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TableOfContents from '../components/TableOfContents.astro';
import TagList from '../components/TagList.astro';
import { readingTime } from '../lib/format';
import { href } from '../lib/url';

interface Props {
  entry: CollectionEntry<'posts'> | CollectionEntry<'notes'>;
  headings: MarkdownHeading[];
  collection: 'posts' | 'notes';
  prev?: { title: string; href: string };
  next?: { title: string; href: string };
}

const { entry, headings, collection, prev, next } = Astro.props;
const { data } = entry;

const kindLabel = collection === 'posts' ? '§ writing' : '§ note';
const indexHref = href(`/${collection}`);
const indexLabel = collection === 'posts' ? 'all writing' : 'all notes';
const minutes = readingTime(entry.body ?? '').minutes;
const lede = 'lede' in data ? data.lede : undefined;

const tocHeadings = headings.filter((heading) => heading.depth <= 3);
const wantsToc = 'toc' in data ? data.toc : false;
const showToc = wantsToc && tocHeadings.length >= 3;
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  math={data.math}
  ogImage={`/og/${collection}/${entry.id}.png`}
  publishedTime={data.date}
  modifiedTime={data.updated}
>
  <div class:list={['shell', { 'has-toc': showToc }]}>
    <header class="article-header">
      <p class="label kind">{kindLabel}</p>
      <h1>{data.title}</h1>
      <p class="dek">{data.description}</p>
      <p class="meta">
        <FormattedDate date={data.date} format="long" />
        <span aria-hidden="true">·</span>
        <span>{minutes} min</span>
        {
          data.updated && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                updated <FormattedDate date={data.updated} format="long" />
              </span>
            </>
          )
        }
        {import.meta.env.DEV && data.draft && <span class="draft">draft</span>}
      </p>
      {data.tags.length > 0 && <TagList tags={data.tags} linked />}
    </header>

    <div class="body">
      <div class="column">
        {
          showToc && (
            <details class="toc-inline">
              <summary>Contents</summary>
              <TableOfContents headings={tocHeadings} />
            </details>
          )
        }
        {lede && <p class="lede">{lede}</p>}
        <article class="prose">
          <slot />
        </article>

        <nav class="article-nav" aria-label="More writing">
          {
            prev && (
              <a class="adjacent newer" href={prev.href}>
                <span class="label">← newer</span>
                <span class="adjacent-title">{prev.title}</span>
              </a>
            )
          }
          {
            next && (
              <a class="adjacent older" href={next.href}>
                <span class="label">older →</span>
                <span class="adjacent-title">{next.title}</span>
              </a>
            )
          }
          <a class="index-link" href={indexHref}>← {indexLabel}</a>
        </nav>
      </div>

      {
        showToc && (
          <aside class="toc-rail">
            <div class="toc-sticky">
              <TableOfContents headings={tocHeadings} />
            </div>
          </aside>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .shell {
    max-width: var(--measure-wide);
    margin-inline: auto;
    padding-inline: var(--gutter);
    padding-block: var(--space-16) var(--space-8);
  }

  .article-header {
    display: grid;
    gap: var(--space-4);
    max-width: var(--measure);
    padding-bottom: var(--space-8);
    margin-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-rule);
  }

  .kind {
    color: var(--color-accent-2);
  }

  h1 {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .dek {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    line-height: 1.45;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .draft {
    padding: 0.1em 0.5em;
    color: var(--color-warn);
    border: 1px solid color-mix(in oklab, var(--color-warn) 45%, transparent);
    border-radius: 999px;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .toc-inline {
    margin-bottom: var(--space-12);
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
  }

  .toc-inline > summary {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .toc-inline[open] > summary {
    margin-bottom: var(--space-4);
  }

  .lede {
    max-width: var(--measure);
    margin-bottom: var(--space-8);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.45;
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .article-nav {
    display: grid;
    gap: var(--space-6);
    max-width: var(--measure);
    margin-top: var(--space-24);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-rule);
  }

  .adjacent {
    display: grid;
    gap: var(--space-2);
    color: var(--color-text);
    text-decoration: none;
  }

  .adjacent .label {
    color: var(--color-text-faint);
    transition: color var(--dur) var(--ease-out);
  }

  .adjacent-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .adjacent:hover {
    color: var(--color-accent);
  }

  .adjacent:hover .label {
    color: var(--color-accent-2);
  }

  .older {
    text-align: right;
  }

  .index-link {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .index-link:hover {
    color: var(--color-accent-2);
  }

  .body {
    position: relative;
  }

  .toc-rail {
    display: none;
  }

  @media (min-width: 40rem) {
    .article-nav {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .index-link {
      grid-column: 1 / -1;
      margin-top: var(--space-4);
    }
  }

  /* Wide viewports lift the contents out of the flow and into the right
   * margin, so the prose column stays aligned with the masthead on every page
   * whether or not the article has a table of contents. */
  @media (min-width: 75rem) {
    .has-toc .toc-inline {
      display: none;
    }

    .has-toc .toc-rail {
      display: block;
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(var(--measure) + var(--space-8));
      width: clamp(
        9rem,
        calc(
          (100vw + var(--measure-wide)) / 2 - 2 * var(--gutter) - var(--measure) - var(--space-8) -
            1rem
        ),
        15rem
      );
    }

    .has-toc .toc-sticky {
      position: sticky;
      top: var(--space-8);
      padding-left: var(--space-6);
      border-left: 1px solid var(--color-rule);
      max-height: calc(100dvh - var(--space-16));
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }
</style>
