---
import { SITE } from '../site.config';
import { absolute } from '../lib/url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KatexStyles from '../components/KatexStyles.astro';
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  math?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  ogImage,
  type = 'website',
  math = false,
  publishedTime,
  modifiedTime,
  noindex = false,
} = Astro.props;

const documentTitle = title === SITE.title ? SITE.title : `${title} · ${SITE.title}`;
const canonical = absolute(Astro.url.pathname);
const socialImage = absolute(ogImage ?? '/og/default.png');
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {/* A page kept out of the index has no canonical URL to advertise. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SITE.title}
      href={absolute('/rss.xml')}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <meta name="theme-color" content="#0b0d14" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f4ec" media="(prefers-color-scheme: light)" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {
      publishedTime && (
        <meta property="article:published_time" content={publishedTime.toISOString()} />
      )
    }
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {math && <KatexStyles />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
