---
/**
 * Colour-scheme switch. The button shows the scheme it will move you to, and
 * both glyphs ship in the markup so the choice is made in CSS — that keeps the
 * first paint correct for readers who never touch it, including those with the
 * system preference and no stored choice. Without JavaScript it simply does
 * nothing; nothing shifts or breaks.
 */
---

<button id="theme-toggle" type="button" aria-label="Toggle colour theme" aria-pressed="false">
  <svg
    class="glyph sun"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
    <path
      d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4 17 7M7 17l-1.6 1.6"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"></path>
  </svg>
  <svg
    class="glyph moon"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M20.4 14.6A8.6 8.6 0 0 1 9.4 3.6a8.6 8.6 0 1 0 11 11Z"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linejoin="round"></path>
  </svg>
</button>

<style>
  button {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    background: none;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--dur) var(--ease-out),
      border-color var(--dur) var(--ease-out);
  }

  button:hover {
    color: var(--color-accent-2);
    border-color: var(--color-rule);
  }

  .glyph {
    grid-area: 1 / 1;
  }

  /* Dark is the default, so the button offers the sun. */
  .moon {
    display: none;
  }

  :root[data-theme='light'] .sun {
    display: none;
  }

  :root[data-theme='light'] .moon {
    display: block;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) .sun {
      display: none;
    }

    :root:not([data-theme]) .moon {
      display: block;
    }
  }
</style>

<script is:inline>
  (() => {
    const button = document.getElementById('theme-toggle');
    if (!button) return;
    const root = document.documentElement;
    const effective = () =>
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const sync = () => button.setAttribute('aria-pressed', String(effective() === 'light'));
    button.addEventListener('click', () => {
      const next = effective() === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });
    sync();
  })();
</script>
