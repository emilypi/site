---
import { slugifyTag } from '../lib/format';
import { href } from '../lib/url';

interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = false } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          {linked ? <a href={href(`/tags/${slugifyTag(tag)}`)}>#{tag}</a> : <span>#{tag}</span>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
    color: var(--color-text-faint);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color var(--dur) var(--ease-out);
  }

  a:hover {
    color: var(--color-accent-2);
  }
</style>
