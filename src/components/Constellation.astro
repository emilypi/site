---
/**
 * A star field drawn once at build time. The positions come from a seeded
 * linear congruential generator over a jittered grid, so the sky is organic but
 * identical on every build — no layout shift, no client JavaScript, no request.
 */

interface Props {
  seed?: number;
  density?: 'low' | 'mid';
}

interface Star {
  x: number;
  y: number;
  r: number;
  opacity: number;
  accent: boolean;
  twinkle: boolean;
  delay: number;
  duration: number;
}

interface Edge {
  x1: number;
  y1: number;
  x2: number;
  y2: number;
}

const WIDTH = 1200;
const HEIGHT = 400;
const LINK_RADIUS = 140;
const LINKS_PER_STAR = 2;
const TWINKLING_STARS = 5;
const ACCENT_SHARE = 0.15;

const { seed = 20260903, density = 'mid' } = Astro.props;

/** Numerical Recipes' LCG: cheap, deterministic, and good enough for a sky. */
function createRandom(state: number): () => number {
  let value = state >>> 0;
  return () => {
    value = (Math.imul(value, 1664525) + 1013904223) >>> 0;
    return value / 0x1_0000_0000;
  };
}

const random = createRandom(seed);
const columns = density === 'low' ? 9 : 10;
const rows = density === 'low' ? 4 : 6;
const cellWidth = WIDTH / columns;
const cellHeight = HEIGHT / rows;

const stars: Star[] = [];
for (let row = 0; row < rows; row += 1) {
  for (let column = 0; column < columns; column += 1) {
    stars.push({
      x: (column + random()) * cellWidth,
      y: (row + random()) * cellHeight,
      r: 0.6 + random() * 1,
      opacity: 0.35 + random() * 0.55,
      accent: random() < ACCENT_SHARE,
      twinkle: false,
      delay: 0,
      duration: 0,
    });
  }
}

const stride = Math.floor(stars.length / TWINKLING_STARS);
for (let index = 0; index < TWINKLING_STARS; index += 1) {
  const star = stars[index * stride + Math.floor(random() * stride)];
  if (!star) continue;
  star.twinkle = true;
  star.duration = 6 + random() * 3;
  star.delay = index * 1.3;
}

const edges: Edge[] = [];
const drawn = new Set<string>();
stars.forEach((star, index) => {
  const nearest = stars
    .map((other, otherIndex) => ({
      other,
      otherIndex,
      distance: Math.hypot(star.x - other.x, star.y - other.y),
    }))
    .filter((candidate) => candidate.otherIndex !== index && candidate.distance <= LINK_RADIUS)
    .sort((a, b) => a.distance - b.distance)
    .slice(0, LINKS_PER_STAR);

  for (const { other, otherIndex } of nearest) {
    const key = index < otherIndex ? `${index}:${otherIndex}` : `${otherIndex}:${index}`;
    if (drawn.has(key)) continue;
    drawn.add(key);
    edges.push({ x1: star.x, y1: star.y, x2: other.x, y2: other.y });
  }
});

const round = (n: number): string => n.toFixed(1);
---

<svg
  class="constellation"
  viewBox={`0 0 ${WIDTH} ${HEIGHT}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  <g class="links" stroke="currentColor" stroke-width="0.6" opacity="0.18">
    {
      edges.map((edge) => (
        <line x1={round(edge.x1)} y1={round(edge.y1)} x2={round(edge.x2)} y2={round(edge.y2)} />
      ))
    }
  </g>
  <g class="stars">
    {
      stars.map((star) => (
        <circle
          class={star.twinkle ? 'star twinkle' : 'star'}
          cx={round(star.x)}
          cy={round(star.y)}
          r={star.r.toFixed(2)}
          fill={star.accent ? 'var(--color-accent-2)' : 'currentColor'}
          opacity={star.opacity.toFixed(2)}
          style={
            star.twinkle
              ? `--twinkle-base: ${star.opacity.toFixed(2)}; --twinkle-peak: ${Math.min(1, star.opacity + 0.4).toFixed(2)}; --twinkle-duration: ${star.duration.toFixed(1)}s; --twinkle-delay: ${star.delay.toFixed(1)}s`
              : undefined
          }
        />
      ))
    }
  </g>
</svg>

<style>
  .constellation {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: var(--color-text-muted);
    mask-image: linear-gradient(to bottom, #000 0%, #000 42%, transparent 92%);
  }

  @media (prefers-reduced-motion: no-preference) {
    .twinkle {
      animation: twinkle var(--twinkle-duration) var(--twinkle-delay) ease-in-out infinite;
    }
  }

  @keyframes twinkle {
    0%,
    100% {
      opacity: var(--twinkle-base);
    }
    50% {
      opacity: var(--twinkle-peak);
    }
  }
</style>
